# ========================================
# KRISHI BONDHU - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# CLIENT-SIDE VARIABLES (Exposed to browser)
# ========================================

# Firebase Configuration (Public - OK to expose)
VITE_FIREBASE_API_KEY=AIzaSyAiJvbH5oE4A86nlw8dHnnuFTlnWrIMvkk
VITE_FIREBASE_AUTH_DOMAIN=krishi-bondhu-16890.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=krishi-bondhu-16890

# API Configuration
# Development: http://localhost:3000/api
# Production: https://your-vercel-url.vercel.app/api
VITE_API_URL=http://localhost:3000/api
VITE_APP_URL=http://localhost:3000

# Google Maps (Optional)
# Get from: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_PLATFORM_KEY=your_google_maps_api_key_here

# ========================================
# SERVER-SIDE VARIABLES (Secret - Never expose)
# ========================================

# Gemini AI API Key (REQUIRED)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (REQUIRED)
# Get from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=krishi
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=krishi

# JWT Secret for Authentication (REQUIRED)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
JWT_SECRET=your-strong-random-jwt-secret-min-32-chars

# Environment
NODE_ENV=development

# ========================================
# SETUP INSTRUCTIONS
# ========================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Fill in the values:
#    - GEMINI_API_KEY from https://aistudio.google.com/app/apikey
#    - MONGODB_URI from MongoDB Atlas
#    - JWT_SECRET (generate new random string)

# 3. Start development:
#    npm run dev

# ========================================
# PRODUCTION DEPLOYMENT
# ========================================

# DO NOT commit .env file to git!
# For production on Vercel:
# 1. Set variables in Vercel Dashboard
# 2. Settings → Environment Variables
# 3. Add: MONGODB_URI, JWT_SECRET, GEMINI_API_KEY as Secrets

# See PRODUCTION_SETUP.md for detailed instructions

