rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: species
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required) - Name of the species
    //   - category: string (required, enum: livestock, poultry, fisheries) - Main category
    //   - description: string (optional) - General description
    //   - farmingMethod: string (optional) - Detailed farming methods
    //   - stockingDensity: string (optional) - Mujud Ghonotto
    //   - biosecurity: string (optional) - Biosecurity protocols
    //   - imageUrl: string (optional) - Image URL
    //
    // Collection: diseases
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required) - Name of the disease
    //   - speciesId: string (required) - Reference to the affected species
    //   - description: string (optional) - Description of the disease
    //   - symptoms: string (optional) - Common symptoms
    //   - treatment: string (optional) - Recommended treatments
    //
    // Collection: products
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required) - Product name
    //   - description: string (optional) - Product description
    //   - benefits: string (optional) - Benefits of the product
    //   - imageUrl: string (optional) - Product image URL
    //   - orderLink: string (optional) - Link to order the product
    //
    // Collection: problemLogs
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - UID of the user
    //   - problem: string (required) - The problem described by the farmer
    //   - solution: string (required) - The solution provided by Gemini AI
    //   - timestamp: timestamp (required) - When the problem was logged
    //
    // Collection: users
    // Document ID: user UID
    // Fields:
    //   - name: string (required)
    //   - address: string (optional)
    //   - phone: string (required)
    //   - email: string (optional)
    //   - role: string (required, enum: user, admin)
    //   - createdAt: timestamp (required)
    //
    // Collection: onlineUsers
    // Document ID: user UID
    // Fields:
    //   - userId: string (required)
    //   - lastSeen: timestamp (required)
    //
    // Collection: marketPrices
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - price: string (required)
    //   - unit: string (required)
    //   - change: string (optional, enum: up, down, stable)
    //   - trend: string (optional)
    //   - district: string (required)
    //   - category: string (required, enum: Crops, Fish, Poultry)
    //
    // Collection: cropCalendar
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - season: string (required)
    //   - stage: string (required)
    //   - tasks: list (required)
    //   - color: string (optional)
    //   - guide: map (required)
    //     - en: string
    //     - bn: string
    //
    // Collection: marketplace
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - price: string (required)
    //   - unit: string (required)
    //   - district: string (required)
    //   - category: string (required)
    //   - description: string (required)
    //   - contact: string (required)
    //   - sellerId: string (required)
    //   - sellerName: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: forumPosts
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required)
    //   - content: string (required)
    //   - category: string (required)
    //   - authorId: string (required)
    //   - authorName: string (required)
    //   - likes: number (required)
    //   - comments: number (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: expertMessages
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - UID of the user this chat belongs to
    //   - senderId: string (required) - UID of the sender or 'ai-expert'
    //   - senderName: string (required)
    //   - text: string (required)
    //   - type: string (required, enum: text, image, file, ai)
    //   - createdAt: timestamp (required)
    //
    // Collection: ponaOrders
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - userName: string (required)
    //   - phone: string (required)
    //   - category: string (required, enum: Fish, Poultry Chicks, Calves, Shrimp)
    //   - details: string (optional)
    //   - status: string (required, enum: pending, contacted, completed)
    //   - createdAt: timestamp (required)
    //
    // Collection: trainingApplications
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - userName: string (required)
    //   - phone: string (required)
    //   - trainingType: string (required)
    //   - feeType: string (required, enum: free, paid)
    //   - status: string (required, enum: pending, approved, completed)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthorizedAdminEmail(email) {
      return email in ["absfeed.info@gmail.com", "admin@farmexagro.com", "admin@absfeed.com", "absfeed.info@gmail.com", "admin"];
    }

    function isAdmin() {
      return isAuthenticated() && 
             (isAuthorizedAdminEmail(request.auth.token.email) || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'));
    }

    function isManager() {
      return isAuthenticated() && 
             (isAuthorizedAdminEmail(request.auth.token.email) || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'manager'])));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        (resource != null && 'userId' in resource.data && request.auth.uid == resource.data.userId) ||
        (resource != null && 'sellerId' in resource.data && request.auth.uid == resource.data.sellerId) ||
        (resource != null && 'authorId' in resource.data && request.auth.uid == resource.data.authorId)
      );
    }

    function isValidSpecies(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.category in ['livestock', 'poultry', 'fisheries', 'vegetables'];
    }

    function isValidDisease(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.speciesId is string;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200;
    }

    function isValidProblemLog(data) {
      return data.userId == request.auth.uid &&
             data.problem is string && data.problem.size() > 0 && data.problem.size() < 5000 &&
             data.solution is string && data.solution.size() > 0 &&
             data.timestamp is timestamp;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 &&
             data.role in ['user', 'manager', 'admin'] &&
             data.createdAt is timestamp &&
             (!('password' in data) || data.password is string) &&
             (!('provider' in data) || data.provider is string);
    }

    function isValidOnlineUser(data) {
      return data.userId == request.auth.uid &&
             data.lastSeen is timestamp;
    }

    function isValidStory(data) {
      return data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000 &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 2000)) &&
             data.createdAt is timestamp;
    }

    function isValidComment(data) {
      return data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 1000 &&
             data.storyId is string &&
             data.createdAt is timestamp;
    }

    function isValidReaction(data) {
      return data.userId == request.auth.uid &&
             data.storyId is string &&
             data.timestamp is timestamp;
    }

    function isValidMarketPrice(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.price is string && data.price.size() > 0 && data.price.size() < 100 &&
             data.unit is string && data.unit.size() > 0 && data.unit.size() < 50 &&
             data.district is string && data.district.size() > 0 &&
             data.category in ['Crops', 'Fish', 'Poultry'];
    }

    function isValidCropCalendar(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.season is string && data.season.size() > 0 &&
             data.stage is string && data.stage.size() > 0 &&
             data.tasks is list && data.tasks.size() < 20 &&
             data.guide is map &&
             data.guide.en is string && data.guide.en.size() > 0 &&
             data.guide.bn is string && data.guide.bn.size() > 0;
    }

    function isValidMarketplaceProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.price is string && data.price.size() > 0 &&
             data.unit is string && data.unit.size() > 0 &&
             data.district is string && data.district.size() > 0 &&
             data.category is string &&
             data.description is string && data.description.size() > 0 && data.description.size() < 2000 &&
             data.contact is string && data.contact.size() > 0 &&
             data.sellerId == request.auth.uid &&
             data.sellerName is string &&
             data.createdAt is timestamp;
    }

    function isValidForumPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000 &&
             data.category is string &&
             data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.likes is number &&
             data.comments is number &&
             data.createdAt is timestamp;
    }

    function isValidUserMarketPrice(data) {
      return data.userId == request.auth.uid &&
             data.userName is string &&
             data.productName is string && data.productName.size() > 0 &&
             data.price is string && data.price.size() > 0 &&
             data.unit is string &&
             data.area is string &&
             data.date is string &&
             data.createdAt is timestamp;
    }

    function isValidExportApplication(data) {
      return data.userId == request.auth.uid &&
             data.name is string &&
             data.phone is string &&
             data.district is string &&
             data.upazila is string &&
             data.productName is string &&
             data.createdAt is timestamp;
    }

    function isValidColdStorage(data) {
      return data.name is string && data.location is string && data.phone is string && data.district is string &&
             data.createdAt is timestamp;
    }

    function isValidRentMachine(data) {
      return data.machineName is string && data.ownerName is string && data.phone is string && data.rate is string && data.district is string &&
             data.createdAt is timestamp;
    }

    function isValidCardApplication(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.phone is string && 
             data.nid is string && data.landSize is string && data.district is string && data.upazila is string &&
             data.createdAt is timestamp;
    }

    function isValidPestWarning(data) {
      return data.title is string && data.description is string && data.area is string && data.severity in ['low', 'medium', 'high'] &&
             data.createdAt is timestamp;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSeedBank(data) {
      return data.seedName is string && data.seedName.size() < 500 &&
             data.variety is string && data.variety.size() < 500 &&
             data.district is string &&
             (data.phone is string || data.contact is string) &&
             data.userId == request.auth.uid &&
             data.createdAt is timestamp;
    }

    function isValidAgentApplication(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.phone is string &&
             data.createdAt is timestamp;
    }

    function isValidFarmJournal(data) {
      return data.userId == request.auth.uid &&
             data.type in ['sowing', 'fertilizing', 'spraying', 'harvesting', 'irrigation', 'other'] &&
             data.date is string &&
             data.createdAt is timestamp;
    }

    function isValidLoanApplication(data) {
      return data.userId == request.auth.uid &&
             data.userName is string &&
             data.phone is string &&
             data.amount is string &&
             data.status in ['pending', 'approved', 'completed'] &&
             data.createdAt is timestamp;
    }

    function isValidProtectionApplication(data) {
      return data.userId == request.auth.uid &&
             data.userName is string &&
             data.phone is string &&
             data.cropType is string &&
             data.totalValue is string &&
             data.status in ['pending', 'approved', 'completed'] &&
             data.createdAt is timestamp;
    }

    function isValidPonaOrder(data) {
      return data.userId == request.auth.uid &&
             data.userName is string &&
             data.phone is string &&
             data.category in ['Fish', 'Poultry Chicks', 'Calves', 'Shrimp'] &&
             data.status in ['pending', 'contacted', 'completed'] &&
             data.createdAt is timestamp;
    }

    function isValidVideo(data) {
      return data.title is string && data.title.size() > 0 &&
             data.titleBn is string && data.titleBn.size() > 0 &&
             data.url is string && data.url.size() > 0 &&
             data.createdAt is timestamp;
    }

    function isValidTrainingApplication(data) {
      return data.userId == request.auth.uid &&
             data.userName is string &&
             data.phone is string &&
             data.trainingType is string &&
             data.feeType in ['free', 'paid'] &&
             data.status in ['pending', 'approved', 'completed'] &&
             data.createdAt is timestamp;
    }

    function isValidExpertMessage(data) {
      return data.userId == request.auth.uid &&
             (data.senderId == request.auth.uid || data.senderId == 'ai-expert') &&
             data.text is string && data.text.size() > 0 && data.text.size() < 10000 &&
             data.type in ['text', 'image', 'file', 'ai'] &&
             data.createdAt is timestamp;
    }

    function isAgent() {
      return isAuthenticated() && 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'agent');
    }

    function getAgentId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('agentId', '');
    }

    function isValidLivestockHealthRequest(data) {
      return data.userId == request.auth.uid &&
             data.ownerName is string &&
             data.phone is string &&
             data.animalType is string &&
             data.createdAt is timestamp;
    }

    function isValidFishWaterTestRequest(data) {
      return data.userId == request.auth.uid &&
             data.ownerName is string &&
             data.phone is string &&
             data.parameters is list &&
             data.createdAt is timestamp;
    }

    // ============= Rules =============
    
    match /test/connection {
      allow read: if true;
    }

    match /agents/{agentDocId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /loanPayments/{payId} {
      allow read: if isAdmin() || isManager() || (isAgent() && resource.data.agentId == getAgentId());
      allow create, update, delete: if isAdmin() || isManager();
    }

    match /protectionUpdates/{updateId} {
      allow read: if true;
      allow create: if isAgent();
      allow update, delete: if isAdmin();
    }

    match /loanApplications/{appId} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.referredByAgentId == getAgentId())));
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    match /protectionApplications/{appId} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.referredByAgentId == getAgentId())));
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isManager() || (isAgent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    match /userMarketPrices/{priceId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidUserMarketPrice(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /exportApplications/{appId} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.agentId == getAgentId())));
      allow create: if isAuthenticated() && isValidExportApplication(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /coldStorage/{storageId} {
      allow list, get: if true || isAdmin() || isManager() || (isAgent() && resource.data.agentId == getAgentId());
      allow create: if isAuthenticated() && isValidColdStorage(request.resource.data);
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /rentMachines/{machineId} {
      allow list, get: if true || isAdmin() || isManager() || (isAgent() && resource.data.agentId == getAgentId());
      allow create: if isAuthenticated() && isValidRentMachine(request.resource.data);
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /soilTestRequests/{id} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.agentId == getAgentId())));
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /cardApplications/{appId} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.referredByAgentId == getAgentId())));
      allow create: if isAuthenticated() && isValidCardApplication(request.resource.data);
      allow update, delete: if isAdmin() || isManager();
    }

    match /pestWarnings/{warningId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /seedBank/{seedId} {
      allow read: if true || isAdmin() || isManager() || (isAgent() && resource.data.agentId == getAgentId());
      allow create: if isAuthenticated() && isValidSeedBank(request.resource.data);
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /siteStats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all'));
    }

    match /users/{userId} {
      allow list: if true;
      allow get: if isAuthenticated() && (isManager() || isAgent() || isOwner(userId));
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && 
                    (request.resource.data.role == 'user' || (request.resource.data.role == 'admin' && isAuthorizedAdminEmail(request.auth.token.email)));
      allow update: if isAdmin() || (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role) || (isAgent() && isOwner(userId));
      allow delete: if isAdmin();
    }

    match /onlineUsers/{userId} {
      allow list: if isManager();
      allow get: if isAuthenticated() && (isManager() || isOwner(userId));
      allow write: if isOwner(userId) && isValidOnlineUser(request.resource.data);
    }

    match /livestockHealthRequests/{id} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.agentId == getAgentId())));
      allow create: if isAuthenticated() && isValidLivestockHealthRequest(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /fishWaterTestRequests/{id} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.agentId == getAgentId())));
      allow create: if isAuthenticated() && isValidFishWaterTestRequest(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /species/{speciesId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSpecies(request.resource.data);
      allow delete: if isAdmin();
    }

    match /diseases/{diseaseId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidDisease(request.resource.data);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /problemLogs/{logId} {
      allow read: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidProblemLog(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidStory(request.resource.data);
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.userId) && isValidStory(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])) ||
        isAdmin()
      );
      allow delete: if isAdmin() || isOwner(resource.data.userId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidComment(request.resource.data);
        allow update, delete: if isAdmin() || isOwner(resource.data.userId);
      }

      match /reactions/{userId} {
        allow read: if true;
        allow write: if isOwner(userId) && isValidReaction(request.resource.data);
      }
    }

    match /marketPrices/{priceId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMarketPrice(request.resource.data);
      allow delete: if isAdmin();
    }

    match /cropCalendar/{cropId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCropCalendar(request.resource.data);
      allow delete: if isAdmin();
    }

    match /marketplace/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidMarketplaceProduct(request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.sellerId == request.auth.uid && isValidMarketplaceProduct(request.resource.data)) ||
        isAdmin() ||
        (isAgent() && resource.data.agentId == getAgentId())
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.sellerId == request.auth.uid);
    }

    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidForumPost(request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.authorId == request.auth.uid && isValidForumPost(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments'])) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    match /farmingLedger/{entryId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == (resource == null ? request.resource.data.userId : resource.data.userId));
    }

    match /mapResources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /agentApplications/{appId} {
      allow read: if isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid)) || resource.data.status == 'approved';
      allow create: if isAuthenticated() && isValidAgentApplication(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /ponaOrders/{orderId} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.agentId == getAgentId())));
      allow create: if isAuthenticated() && isValidPonaOrder(request.resource.data);
      allow update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    match /trainingApplications/{appId} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || (isAgent() && resource.data.agentId == getAgentId())));
      allow create: if isAuthenticated() && isValidTrainingApplication(request.resource.data);
      allow update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    function isValidExpertMessage(data) {
      return data.userId == request.auth.uid &&
             (data.senderId == request.auth.uid || data.senderId == 'ai-expert') &&
             data.text is string && data.text.size() > 0 && data.text.size() < 10000 &&
             data.type in ['text', 'image', 'file', 'ai'] &&
             data.createdAt is timestamp;
    }

    match /expertMessages/{msgId} {
      allow list, get: if isAdmin() || isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidExpertMessage(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /farmJournal/{entryId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == (resource == null ? request.resource.data.userId : resource.data.userId));
    }

    match /knowledgeBase/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidVideo(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
